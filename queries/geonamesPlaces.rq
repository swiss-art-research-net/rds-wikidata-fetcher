PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
CONSTRUCT {
    ?geonamesPlace rdf:type ?wdType , crm:E53_Place .
    ?geonamesPlace wdt:P31 ?wdType .
    ?geonamesPlace rdfs:label ?name .
    ?geonamesPlace schema:description ?description .
    ?geonamesPlace owl:sameAs ?geonames .
    ?geonamesPlace ?predicate ?additionalProperty .
}

WHERE {
    ?geonamesPlace wdt:P1566 ?geonamesId .
    ?geonamesPlace wdt:P31 ?wdType .
    ?geonamesPlace rdfs:label ?name .
    ?geonamesPlace schema:description ?description .
    BIND(URI(CONCAT("https://sws.geonames.org/", ?geonamesId, "/")) as ?geonames)
    OPTIONAL {
        VALUES ?predicate {
            wdt:P1476
            wdt:P1680
            wdt:P18
            wdt:P2096
            wdt:P569
            wdt:P570
            wdt:P571
            wdt:P576
            wdt:P577
            wdt:P580
            wdt:P582
            wdt:P585
            wdt:P625
        }
        ?geonamesPlace ?predicate ?additionalProperty .
    }
    FILTER (LANG(?name) = "en")
    FILTER (LANG(?description) = "en")
}
