PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
CONSTRUCT {
    ?aatConcept rdf:type ?wdType, crm:E55_Type .
    ?aatConcept wdt:P31 ?wdType .
    ?aatConcept rdfs:label ?name .
    ?aatConcept schema:description ?description .
    ?aatConcept owl:sameAs ?aat .
    ?aatConcept ?predicate ?additionalProperty .
}

WHERE {
    ?aatConcept wdt:P1014 ?aatType .
    ?aatConcept wdt:P31 ?wdType .
    ?aatConcept rdfs:label ?name .
    ?aatConcept schema:description ?description .
    OPTIONAL {
        VALUES ?predicate {
            wdt:P18
            wdt:P2096
            wdt:P279
            wdt:P361
            wdt:P366
            wdt:P186
            wdt:P571
            wdt:P495
        }
        ?aatConcept ?predicate ?additionalProperty .
    }
    BIND(URI(CONCAT("http://vocab.getty.edu/aat/", STR(?aatType))) AS ?aat)
    FILTER (LANG(?name) = "en")
    FILTER (LANG(?description) = "en")
}