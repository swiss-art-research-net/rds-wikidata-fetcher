PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX schema: <http://schema.org/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
CONSTRUCT {
    ?ulanArtist rdf:type ?wdType , wd:Q5, crm:E39_Actor .
    ?ulanArtist wdt:P31 ?wdType .
    ?ulanArtist rdfs:label ?name .
    ?ulanArtist schema:description ?description .
    ?ulanArtist owl:sameAs ?ulan .
    ?ulanArtist ?predicate ?additionalProperty .
}

WHERE {
    ?ulanArtist wdt:P245 ?ulanId .
    ?ulanArtist wdt:P31 ?wdType .
    ?ulanArtist rdfs:label ?name .
    ?ulanArtist schema:description ?description .
    OPTIONAL {
        VALUES ?predicate {
            wdt:P1476
            wdt:P1680
            wdt:P18
            wdt:P2096
            wdt:P569
            wdt:P570
            wdt:P571
            wdt:P576
            wdt:P577
            wdt:P580
            wdt:P582
            wdt:P585
            wdt:P625
        }
        ?ulanArtist ?predicate ?additionalProperty .
    }
    BIND(URI(CONCAT("http://vocab.getty.edu/ulan/", ?ulanId)) as ?ulan)
    FILTER (LANG(?name) = "en")
    FILTER (LANG(?description) = "en")
}
